{
  "uid": "spectrum-change-management",
  "title": "Detailed Change Management",
  "tags": [
    "operational-reports",
    "asset"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data Source",
        "query": "mysql",
        "hide": 0,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "Spectrum Reporting",
          "value": "RQntVjiNk"
        },
        "options": [],
        "description": "The MySQL data source for the Spectrum reporting database. Set this to your own after importing."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Devices Added",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS added FROM reporting.devicemodel dm WHERE $__timeFilter(dm.create_time)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Devices Removed",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS removed FROM reporting.devicemodel dm WHERE $__timeFilter(dm.destroy_time)"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Change Log (devices added / removed in range)",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 22
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Change"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Added": {
                        "color": "green",
                        "index": 0
                      },
                      "Removed": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.`Time`, t.`Change`, t.`Device`, t.`Model Name`, t.`Class`, t.`By` FROM (SELECT dm.create_time AS `Time`, 'Added' AS `Change`, CONCAT(v.vendor_name,'-',dm.device_type) AS `Device`, dm.model_name AS `Model Name`, mc.mclass_name AS `Class`, dm.model_creator AS `By` FROM reporting.devicemodel dm JOIN reporting.vendor v ON v.vendor=dm.vendor JOIN reporting.modelclass mc ON mc.model_class=dm.model_class WHERE $__timeFilter(dm.create_time) UNION ALL SELECT dm.destroy_time, 'Removed', CONCAT(v.vendor_name,'-',dm.device_type), dm.model_name, mc.mclass_name, dm.model_destroyer FROM reporting.devicemodel dm JOIN reporting.vendor v ON v.vendor=dm.vendor JOIN reporting.modelclass mc ON mc.model_class=dm.model_class WHERE $__timeFilter(dm.destroy_time) ) t ORDER BY t.`Time` DESC"
        }
      ]
    }
  ]
}
