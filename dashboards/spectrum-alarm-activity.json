      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS cleared FROM reporting.alarmactivity aa JOIN reporting.alarminfo ai ON ai.alarm_key=aa.alarm_key WHERE $__timeFilter(aa.time) AND aa.activity<>1 AND (-1 IN ($group) OR ai.model_key IN (SELECT model_key FROM reporting.gcmodel WHERE gc_rec_ID IN ($group))) AND (-1 IN ($devices) OR ai.model_key IN ($devices)) AND aa.activity IN (4,5)"
        }
