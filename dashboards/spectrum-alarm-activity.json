            "Acknowledged",
            "Assigned By",
            "Assigned To",
            "Ticketed",
            "Total Activities"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN aa.user IS NULL OR aa.user='' THEN 'SPECTRUM SOFTWARE' ELSE aa.user END AS `User`, SUM(aa.activity IN (4,5)) AS `Cleared`, SUM(aa.activity=2) AS `Acknowledged`, SUM(aa.activity=3) AS `Assigned By`, SUM(aa.activity=33) AS `Assigned To`, SUM(aa.activity=6) AS `Ticketed`, COUNT(*) AS `Total Activities` FROM reporting.alarmactivity aa JOIN reporting.alarminfo ai ON ai.alarm_key=aa.alarm_key WHERE $__timeFilter(aa.time) AND aa.activity<>1 AND (-1 IN ($group) OR ai.model_key IN (SELECT model_key FROM reporting.gcmodel WHERE gc_rec_ID IN ($group))) AND (-1 IN ($devices) OR ai.model_key IN ($devices)) GROUP BY `User` ORDER BY `Total Activities` DESC"
