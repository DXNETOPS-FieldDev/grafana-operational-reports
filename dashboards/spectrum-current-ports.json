{
  "uid": "spectrum-current-ports",
  "title": "Current Ports",
  "tags": [
    "operational-reports",
    "asset"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data Source",
        "query": "mysql",
        "regex": "/^Spectrum (Reporting|MySQL)$/",
        "hide": 2,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "Spectrum Reporting",
          "value": "RQntVjiNk"
        },
        "options": []
      },
      {
        "name": "group",
        "type": "query",
        "label": "Global Collection",
        "datasource": {
          "type": "mysql",
          "uid": "${datasource}"
        },
        "query": "SELECT gc_name AS __text, gc_rec_ID AS __value FROM reporting.globalcollection ORDER BY gc_name",
        "definition": "SELECT gc_name AS __text, gc_rec_ID AS __value FROM reporting.globalcollection ORDER BY gc_name",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "allValue": "-1"
      },
      {
        "name": "deviceType",
        "type": "query",
        "label": "Device Type",
        "datasource": {
          "type": "mysql",
          "uid": "${datasource}"
        },
        "query": "SELECT DISTINCT device_type FROM reporting.devicemodel WHERE device_type IS NOT NULL AND destroy_time IS NULL ORDER BY 1",
        "definition": "SELECT DISTINCT device_type FROM reporting.devicemodel WHERE device_type IS NOT NULL AND destroy_time IS NULL ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Devices",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT dm.model_key) AS devices FROM reporting.interfacemodel im JOIN reporting.devicemodel dm ON dm.model_key=im.device_model_key WHERE im.destroy_time IS NULL AND dm.destroy_time IS NULL AND dm.device_type IN (${deviceType:singlequote}) AND (-1 IN ($group) OR dm.model_key IN (SELECT model_key FROM reporting.gcmodel WHERE gc_rec_ID IN ($group)))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Ports",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS ports FROM reporting.interfacemodel im JOIN reporting.devicemodel dm ON dm.model_key=im.device_model_key WHERE im.destroy_time IS NULL AND dm.destroy_time IS NULL AND dm.device_type IN (${deviceType:singlequote}) AND (-1 IN ($group) OR dm.model_key IN (SELECT model_key FROM reporting.gcmodel WHERE gc_rec_ID IN ($group)))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Up Ports",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT SUM(im.port_link_status=0) AS up_ports FROM reporting.interfacemodel im JOIN reporting.devicemodel dm ON dm.model_key=im.device_model_key WHERE im.destroy_time IS NULL AND dm.destroy_time IS NULL AND dm.device_type IN (${deviceType:singlequote}) AND (-1 IN ($group) OR dm.model_key IN (SELECT model_key FROM reporting.gcmodel WHERE gc_rec_ID IN ($group)))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Port Availability",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(100*SUM(im.port_link_status=0)/COUNT(*),2) AS port_avail FROM reporting.interfacemodel im JOIN reporting.devicemodel dm ON dm.model_key=im.device_model_key WHERE im.destroy_time IS NULL AND dm.destroy_time IS NULL AND dm.device_type IN (${deviceType:singlequote}) AND (-1 IN ($group) OR dm.model_key IN (SELECT model_key FROM reporting.gcmodel WHERE gc_rec_ID IN ($group)))"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Current Ports Summary (by Device)",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Port Availability %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 90
                    },
                    {
                      "color": "green",
                      "value": 99
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total Ports"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-blues"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Device detail: ${__value.text}",
                    "url": "/d/spectrum-device-detail/spectrum-device-detail?var-device=${__value.text}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Port Availability %",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.entity_name AS `Name`, COUNT(*) AS `Total Ports`, SUM(im.port_link_status=0) AS `Up`, SUM(im.port_link_status<>0) AS `Down`, ROUND(100*SUM(im.port_link_status=0)/COUNT(*),2) AS `Port Availability %` FROM reporting.interfacemodel im JOIN reporting.devicemodel dm ON dm.model_key=im.device_model_key JOIN reporting.entity e ON e.current_model_key=dm.model_key WHERE im.destroy_time IS NULL AND dm.destroy_time IS NULL AND dm.device_type IN (${deviceType:singlequote}) AND (-1 IN ($group) OR dm.model_key IN (SELECT model_key FROM reporting.gcmodel WHERE gc_rec_ID IN ($group))) GROUP BY e.entity_name ORDER BY `Port Availability %` ASC, `Name`"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Current Port Assets",
      "datasource": {
        "type": "mysql",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Speed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Good": {
                        "color": "green",
                        "index": 0
                      },
                      "Bad": {
                        "color": "red",
                        "index": 1
                      },
                      "Disabled": {
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Device"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Device detail: ${__value.text}",
                    "url": "/d/spectrum-device-detail/spectrum-device-detail?var-device=${__value.text}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Device",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${datasource}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.entity_name AS `Device`, im.model_name AS `Port`, im.port_type AS `Type`, im.if_speed AS `Speed`, ipl.name AS `Status`, NULLIF(im.ifAlias,'') AS `Alias` FROM reporting.interfacemodel im JOIN reporting.devicemodel dm ON dm.model_key=im.device_model_key JOIN reporting.entity e ON e.current_model_key=dm.model_key JOIN reporting.ipls_names ipl ON ipl.status=im.port_link_status WHERE im.destroy_time IS NULL AND dm.destroy_time IS NULL AND dm.device_type IN (${deviceType:singlequote}) AND (-1 IN ($group) OR dm.model_key IN (SELECT model_key FROM reporting.gcmodel WHERE gc_rec_ID IN ($group))) ORDER BY e.entity_name, im.model_name LIMIT 1000"
        }
      ]
    }
  ]
}